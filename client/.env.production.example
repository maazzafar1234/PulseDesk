# PulseDesk Frontend - Production Environment Variables
# Copy this file to .env.production and update values for your environment

# API Configuration
# Point to your production backend API URL (e.g., AWS ALB, CloudFront, API Gateway)
VITE_API_URL=https://api.pulsedesk.example.com

# Alternative environment variable name (backward compatibility)
# VITE_API_BASE_URL=https://api.pulsedesk.example.com

# Application Configuration
VITE_APP_NAME=PulseDesk
VITE_APP_TITLE=PulseDesk - Support Ticketing System

# Feature Flags (optional)
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_SENTRY=true

# Sentry Configuration (for error tracking)
VITE_SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# Analytics Configuration (optional)
VITE_GA_ID=UA-XXXXXXXX-X
