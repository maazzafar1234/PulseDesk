pipeline {
    agent {
        label 'worker'
    }
    
    environment {
        DOCKER_REGISTRY = 'docker.io'
        DOCKER_USERNAME = credentials('docker-credentials-username')
        DOCKER_PASSWORD = credentials('docker-credentials-password')
        DOCKER_REPO = "${DOCKER_USERNAME}/pulsedesk"
        SONAR_HOST_URL = "http://master-ip:9000"
        SONARQUBE_TOKEN = credentials('sonarqube-token')
        GIT_CREDENTIALS = credentials('github-credentials')
        BUILD_TIMESTAMP = sh(script: "date +%Y%m%d-%H%M%S", returnStdout: true).trim()
    }
    
    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
    }
    
    stages {
        stage('Checkout Code') {
            steps {
                cleanWs()
                checkout([
                    $class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[
                        url: 'https://github.com/your-username/pulsedesk.git',
                        credentialsId: 'github-credentials'
                    ]]
                ])
            }
        }
        
        stage('Build Backend') {
            steps {
                script {
                    sh '''
                        if [ -d "server" ]; then
                            cd server
                            npm install
                            echo "Backend is Node.js - no build step needed"
                            cd ..
                        else
                            echo "❌ server/ directory not found!"
                            exit 1
                        fi
                    '''
                }
            }
        }
        
        stage('Build Frontend') {
            steps {
                script {
                    sh '''
                        if [ -d "client" ]; then
                            cd client
                            npm install
                            npm run build
                        else
                            echo "❌ client/ directory not found!"
                            exit 1
                        fi
                    '''
                }
            }
        }
        
        stage('OWASP Dependency Check') {
            steps {
                script {
                    sh '''
                        docker run --rm -v ${WORKSPACE}:/src owasp/dependency-check:latest \
                            --scan /src \
                            --format HTML \
                            --out /src/dependency-check-report \
                            --project PulseDesk || true
                    '''
                }
            }
        }
        
        stage('SonarQube Analysis') {
            steps {
                script {
                    sh '''
                        docker run --rm \
                            -e SONAR_HOST_URL=${SONAR_HOST_URL} \
                            -e SONAR_LOGIN=${SONARQUBE_TOKEN} \
                            -v ${WORKSPACE}:/usr/src \
                            sonarsource/sonar-scanner-cli:latest \
                            -Dsonar.projectKey=pulsedesk \
                            -Dsonar.projectName=PulseDesk \
                            -Dsonar.sources=server,client \
                            -Dsonar.exclusions=**/node_modules/**,**/dist/**,**/build/**,**/.git/**
                    '''
                }
            }
        }
        
        stage('Build Docker Images') {
            steps {
                script {
                    sh '''
                        if [ -d "client" ] && [ -d "server" ]; then
                            docker build -t ${DOCKER_REPO}:frontend-${BUILD_NUMBER} \
                                       -t ${DOCKER_REPO}:frontend-latest \
                                       ./client
                            
                            docker build -t ${DOCKER_REPO}:backend-${BUILD_NUMBER} \
                                       -t ${DOCKER_REPO}:backend-latest \
                                       ./server
                        else
                            echo "❌ Required directories not found (client/ and/or server/)"
                            exit 1
                        fi
                    '''
                }
            }
        }
        
        stage('Trivy Image Scan') {
            steps {
                script {
                    sh '''
                        trivy image --exit-code 0 --severity HIGH,CRITICAL \
                            ${DOCKER_REPO}:frontend-${BUILD_NUMBER}
                        
                        trivy image --exit-code 0 --severity HIGH,CRITICAL \
                            ${DOCKER_REPO}:backend-${BUILD_NUMBER}
                    '''
                }
            }
        }
        
        stage('Push to Docker Registry') {
            steps {
                script {
                    sh '''
                        echo ${DOCKER_PASSWORD} | docker login -u ${DOCKER_USERNAME} --password-stdin
                        
                        docker push ${DOCKER_REPO}:frontend-${BUILD_NUMBER}
                        docker push ${DOCKER_REPO}:frontend-latest
                        
                        docker push ${DOCKER_REPO}:backend-${BUILD_NUMBER}
                        docker push ${DOCKER_REPO}:backend-latest
                        
                        docker logout
                    '''
                }
            }
        }
        
        stage('Update Kubernetes Manifests') {
            steps {
                script {
                    sh '''
                        if [ -d "kubernetes" ]; then
                            cd kubernetes
                            
                            # Update frontend image
                            sed -i "s|image: .*frontend.*|image: ${DOCKER_REPO}:frontend-${BUILD_NUMBER}|g" frontend-deployment.yaml || echo "frontend-deployment.yaml not found or no image to update"
                            
                            # Update backend image
                            sed -i "s|image: .*backend.*|image: ${DOCKER_REPO}:backend-${BUILD_NUMBER}|g" backend-deployment.yaml || echo "backend-deployment.yaml not found or no image to update"
                            
                            git config user.email "jenkins@pulsedesk.local"
                            git config user.name "Jenkins CI"
                            
                            git add frontend-deployment.yaml backend-deployment.yaml 2>/dev/null || true
                            git commit -m "Update container images - Build ${BUILD_NUMBER}" || echo "No changes to commit"
                            
                            git push https://${GIT_CREDENTIALS_USR}:${GIT_CREDENTIALS_PSW}@github.com/your-username/pulsedesk.git main || echo "Push failed - this might be expected if no changes"
                            cd ..
                        else
                            echo "⚠️ kubernetes/ directory not found"
                        fi
                    '''
                }
            }
        }
    }
    
    post {
        always {
            archiveArtifacts artifacts: '**/dependency-check-report/**', 
                             allowEmptyArchive: true
            publishHTML([
                reportDir: 'dependency-check-report',
                reportFiles: 'index.html',
                reportName: 'OWASP Dependency Check Report'
            ])
            cleanWs()
        }
        
        success {
            echo "Build successful - Build #${BUILD_NUMBER}"
            build job: 'Wanderlust-CD', wait: false, parameters: [
                string(name: 'BUILD_NUMBER', value: "${BUILD_NUMBER}")
            ]
        }
        
        failure {
            echo "Build failed - Build #${BUILD_NUMBER}"
        }
    }
}
