# PulseDesk - Environment Configuration Template
# Copy this file to .env and update values for your environment

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# Frontend API Base URL (used by client)
# For local development: http://localhost:5000
# For production: your API gateway/load balancer URL
VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# ============================================================================
# BACKEND CONFIGURATION
# ============================================================================

# Server Port
PORT=5000

# Node Environment (development | staging | production)
NODE_ENV=development

# Frontend URL for CORS (can be comma-separated for multiple origins)
# For local: http://localhost:5173
# For production: https://pulsedesk.example.com
FRONTEND_URL=http://localhost:5173

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# LOCAL DEVELOPMENT (SQLite - default)
# Use file-based SQLite for zero-config local development
DATABASE_URL=file:./data/pulsedesk.db

# PRODUCTION (PostgreSQL - AWS RDS)
# Uncomment and update for production use with AWS RDS
# Format: postgresql://username:password@host:port/database
# Example: postgresql://pulsedesk:secure-password@prod-rds-instance.abc123.us-east-1.rds.amazonaws.com:5432/pulsedesk
# DATABASE_URL=postgresql://user:password@host:5432/pulsedesk

# DATABASE_POOL_SIZE (for PostgreSQL connection pooling)
# Default: 20 connections
DATABASE_POOL_SIZE=20

# DATABASE_IDLE_TIMEOUT (milliseconds before connection is closed)
# Default: 30000ms (30 seconds)
DATABASE_IDLE_TIMEOUT=30000

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# JWT Secret Key (used for token signing)
# IMPORTANT: Use a strong, random string in production
# Generate with: openssl rand -hex 32
# OR: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Expiration (default: 7 days)
JWT_EXPIRATION=7d

# HTTPS/SSL Configuration
# In production with HTTPS, set to 'true'
SECURE_COOKIES=false

# ============================================================================
# RATE LIMITING
# ============================================================================

# Rate limit window (milliseconds)
# Default: 15 minutes = 15 * 60 * 1000
RATE_LIMIT_WINDOW_MS=900000

# Rate limit max requests per window
RATE_LIMIT_MAX_REQUESTS=100

# Auth-specific rate limit (login/register attempts)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Prometheus Metrics Endpoint
# Metrics available at: /metrics
PROMETHEUS_ENABLED=true

# Log Level (error | warn | info | debug)
LOG_LEVEL=info

# ============================================================================
# AWS CONFIGURATION (for EKS/RDS deployment)
# ============================================================================

# AWS Region
AWS_REGION=us-east-1

# AWS ECR Repository (for Docker image)
# Example: 123456789012.dkr.ecr.us-east-1.amazonaws.com/pulsedesk
AWS_ECR_REPOSITORY=

# RDS Instance Details (auto-detected if DATABASE_URL is set)
# RDS_ENDPOINT=prod-rds-instance.abc123.us-east-1.rds.amazonaws.com
# RDS_PORT=5432
# RDS_DATABASE=pulsedesk
# RDS_USERNAME=pulsedesk

# ============================================================================
# KUBERNETES CONFIGURATION (for EKS deployment)
# ============================================================================

# Kubernetes Namespace
K8S_NAMESPACE=production

# Service Replica Count (for HPA, this is the initial count)
K8S_REPLICAS=3

# Resource Requests/Limits (in containers)
K8S_CPU_REQUEST=250m
K8S_CPU_LIMIT=1000m
K8S_MEMORY_REQUEST=512Mi
K8S_MEMORY_LIMIT=1Gi

# ============================================================================
# CI/CD CONFIGURATION (Jenkins/ArgoCD)
# ============================================================================

# Git Repository
GIT_REPOSITORY=https://github.com/maazzafar1234/PulseDesk.git
GIT_BRANCH=main

# Docker Image Version/Tag (set by CI/CD pipeline)
DOCKER_IMAGE_TAG=latest

# ArgoCD Application Name
ARGOCD_APP_NAME=pulsedesk

# ============================================================================
# OPTIONAL: SENTRY (Error Tracking)
# ============================================================================

# SENTRY_DSN=https://your-sentry-key@sentry.io/project-id

# ============================================================================
# OPTIONAL: THIRD-PARTY SERVICES
# ============================================================================

# Email Configuration (for future notifications)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password

# Slack Notifications (for alerts)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
