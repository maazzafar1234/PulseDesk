# PulseDesk Backend - Server Environment Variables
# Copy this file to .env and configure for your environment

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================

# Server Port (default: 5000)
PORT=5000

# Node Environment (development | staging | production)
NODE_ENV=development

# Frontend URL for CORS (supports multiple comma-separated origins)
FRONTEND_URL=http://localhost:5173

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# LOCAL DEVELOPMENT (SQLite - file-based, zero config)
DATABASE_URL=file:./data/pulsedesk.db

# PRODUCTION (AWS RDS PostgreSQL)
# Uncomment and update these for production deployment
# Format: postgresql://username:password@host:port/database
# Example:
#   postgresql://pulsedesk:MyP@ssw0rd!@prod-instance.abc123.us-east-1.rds.amazonaws.com:5432/pulsedesk_prod
#
# To generate secure connection string:
#   1. Create RDS instance via Terraform (see terraform/main.tf)
#   2. Get endpoint from: aws rds describe-db-instances
#   3. Format: postgresql://admin:password@endpoint:5432/database_name
#
# DATABASE_URL=postgresql://username:password@host:port/database

# Connection Pool Settings (PostgreSQL only)
DATABASE_POOL_SIZE=20
DATABASE_IDLE_TIMEOUT=30000

# ============================================================================
# SECURITY
# ============================================================================

# JWT Secret for Token Signing
# IMPORTANT: Generate a strong random string for production!
# Generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# JWT Token Expiration
JWT_EXPIRATION=7d

# Enable Secure Cookies (HTTPS only)
# Set to 'true' in production
SECURE_COOKIES=false

# ============================================================================
# RATE LIMITING
# ============================================================================

# Global Rate Limit (15 minutes, 100 requests per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Auth Rate Limit (5 attempts per IP in 15 minutes)
AUTH_RATE_LIMIT_MAX_ATTEMPTS=5

# ============================================================================
# MONITORING & OBSERVABILITY
# ============================================================================

# Prometheus Metrics
# Metrics endpoint: GET /metrics
PROMETHEUS_ENABLED=true

# Logging Level (error | warn | info | debug)
LOG_LEVEL=info

# ============================================================================
# AWS CONFIGURATION
# ============================================================================

# AWS Region (for RDS and other services)
AWS_REGION=us-east-1

# AWS ECR Repository URL (for Docker image pushes)
AWS_ECR_REPOSITORY=123456789012.dkr.ecr.us-east-1.amazonaws.com/pulsedesk

# ============================================================================
# KUBERNETES / HELM CONFIGURATION
# ============================================================================

# Kubernetes Namespace (set by Helm/ArgoCD)
K8S_NAMESPACE=production

# Pod Replica Count
K8S_REPLICAS=3

# Resource Limits
K8S_CPU_REQUEST=250m
K8S_CPU_LIMIT=1000m
K8S_MEMORY_REQUEST=512Mi
K8S_MEMORY_LIMIT=1Gi

# ============================================================================
# CI/CD PIPELINE
# ============================================================================

# Git Configuration
GIT_REPOSITORY=https://github.com/maazzafar1234/PulseDesk.git
GIT_BRANCH=main

# Docker Image Tag (set by Jenkins during build)
DOCKER_IMAGE_TAG=latest

# ArgoCD Configuration
ARGOCD_APP_NAME=pulsedesk
ARGOCD_REPO_URL=https://github.com/maazzafar1234/PulseDesk.git
ARGOCD_PATH=k8s

# ============================================================================
# OPTIONAL: ERROR TRACKING (Sentry)
# ============================================================================

# SENTRY_DSN=https://key@sentry.io/12345

# ============================================================================
# OPTIONAL: NOTIFICATIONS
# ============================================================================

# Slack Webhook for Alerts
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Email Configuration (for future use)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
